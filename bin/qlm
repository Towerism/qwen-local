#!/usr/bin/python3 -I
# Reached through ~/.local/bin/qlm, so resolve the real path to find the repo.
# -I ignores PYTHONPATH and the current directory, hence the explicit sys.path entry.
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from qlm.cli import main  # noqa: E402

raise SystemExit(main())
